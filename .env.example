# 機器人專案環境變數範例
# 複製此檔案為 .env 並根據需求修改

# === Logging ===
# 日誌級別: DEBUG, INFO, WARNING, ERROR, CRITICAL
ROBOT_LOG_LEVEL=INFO

# 日誌目錄 (預設: /home/robot0/base_dev/logs)
# ROBOT_LOG_DIR=/home/robot0/base_dev/logs

# === API Server (Winstec Robot API v1.1) ===
# REST 與 WebSocket 監聽 port，規格指定 5000 / 5001
# ROBOT_API_PORT=5000
# ROBOT_WS_PORT=5001

# CORS 允許的來源 (逗號分隔，預設: * 允許全部)
# CORS_ORIGINS=http://localhost:3000,http://192.168.1.100:3000

# 地圖儲存路徑
# ROBOT_MAP_PATH=/home/robot0/base_dev/map

# API 座標單位換算：ROS 公尺 → API 整數座標
# 100 = 公分 (本專案採用)，1000 = 公釐
# COORD_SCALE=100

# === 電池 (24V 30Ah 18650 鋰電 7S，用於 robot_info 的 battery 百分比) ===
# 滿充 7 × 4.2V = 29.4V，放空 7 × 3.0V = 21.0V
# BATTERY_MIN_V=21.0
# BATTERY_MAX_V=29.4

# === 硬體選項（robot_bringup.sh 讀取，控制開機自啟版本）===
# 皆預設 false，因為 IMU 與實體急停目前未接線。接上後改為 true。
#   ENABLE_IMU=false   未接 BNO055 時務必 false，否則節點崩潰、log 噴錯
#   ENABLE_ESTOP=false 未接急停按鈕時務必 false，否則腳位浮接被判成「按下」，
#                      馬達永久拒收所有速度指令（症狀：遙控完全沒反應）
# ENABLE_IMU=false
# ENABLE_ESTOP=false

# Pico 感測器集線板序列埠（pico_sensor_bringup.sh 讀取，robot-pico-sensor 服務）
# 預設走 udev rule 固定節點 /dev/pico_sensor_hub；沒裝 rule 時改指 ttyACM
# （注意 Pico 每次重新列舉都可能換號，長期還是要裝 rule）
# PICO_PORT=/dev/pico_sensor_hub

# === 硬體設定 ===
# 馬達串口 (通常在 YAML 配置中設定)
# MOTOR_SERIAL_PORT=/dev/ttyUSB_MOTOR

# LiDAR 串口
# LIDAR_SERIAL_PORT=/dev/ttyUSB_LIDAR
