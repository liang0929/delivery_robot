[Unit]
Description=Robot ROS2 Core Services
After=network.target

[Service]
Type=simple
User=robot0
Group=robot0
WorkingDirectory=/home/robot0/base_dev
ExecStart=/home/robot0/base_dev/scripts/robot_bringup.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# 環境變數
Environment="HOME=/home/robot0"
Environment="USER=robot0"

[Install]
WantedBy=multi-user.target
