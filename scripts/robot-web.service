[Unit]
Description=Robot Web Frontend
After=network.target robot-core.service
Wants=robot-core.service

[Service]
Type=simple
User=robot0
Group=robot0
WorkingDirectory=/home/robot0/base_dev/src/robot_web_frontend
ExecStart=/home/robot0/base_dev/scripts/web_frontend.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Node.js 環境
Environment="HOME=/home/robot0"
Environment="USER=robot0"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=multi-user.target
