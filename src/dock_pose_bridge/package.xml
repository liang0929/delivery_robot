<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dock_pose_bridge</name>
  <version>0.1.0</version>
  <description>AprilTag 的 TF 轉成 opennav_docking 用的 detected_dock_pose (PoseStamped)</description>
  <maintainer email="jetson@todo.todo">jetson</maintainer>
  <license>MIT</license>

  <!-- Build dependencies -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime dependencies -->
  <!-- 刻意只依賴這三個：opennav_docking / apriltag_ros 都還沒安裝，
       本 package 必須在「包還沒裝」的機器上 build 得起來、測得過。
       接收端只認 geometry_msgs/PoseStamped，不需要 opennav 的任何訊息型別。 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <!-- Test dependencies -->
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
